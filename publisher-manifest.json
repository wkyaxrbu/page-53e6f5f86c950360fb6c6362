top:-2px;font-size:.86rem;letter-spacing:.06em;color:var(--cyan);font-weight:800}\n.faq p{font-size:.94rem;color:#4b555d;margin-bottom:16px}\n\n/* 说明与页脚 */\n.notice{border-radius:var(--radius);background:var(--slate);color:#dfe7ea;padding:32px 34px;display:grid;grid-template-columns:1fr 1fr;gap:26px}\n.notice h2{font-size:1.24rem;color:#fff;margin-bottom:10px}\n.notice p{font-size:.92rem;margin:0 0 10px;color:#c6d0d5}\n.notice ul{margin:0;padding-left:1.1em;font-size:.92rem;color:#c6d0d5}\n.notice li{margin-bottom:6px}\nfooter{padding:36px 0 54px;border-top:1px solid var(--slate-line);margin-top:20px;font-size:.86rem;color:#6d787f}\nfooter .frow{display:flex;flex-wrap:wrap;gap:12px 26px;justify-content:space-between;align-items:baseline}\nfooter a{color:var(--slate-soft)}\nfooter .fname{letter-spacing:.26em;font-weight:700;color:var(--slate-deep)}\n\n@media (max-width:880px){\n  .hero-grid{grid-template-columns:1fr;gap:30px}\n  .steps{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;gap:16px}\n  .plan-feats{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  .faq-list{grid-template-columns:1fr}\n  .notice{grid-template-columns:1fr}\n  .sec-head{grid-template-columns:1fr}\n  .sec-head p{grid-column:1}\n  .sec-head .idx{display:block}\n}\n@media (max-width:520px){\n  .hero{padding:38px 0 46px}\n  section{padding:46px 0}\n  .plans{padding:6px 14px}\n  .card{padding:22px 20px}\n  .hero-panel{padding:22px 20px}\n}\n</style><main>\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <span class=\"brand-mark\">银河云</span>\n        <ul class=\"anchors\">\n          <li><a href=\"#how\">使用步骤</a></li>\n          <li><a href=\"#plans\">套餐</a></li>\n          <li><a href=\"#clients\">客户端</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </div>\n      <div class=\"hero-grid\">\n        <div>\n          <h1>银河云<br><span>订阅之前，先把三件事看清</span></h1>\n          <p class=\"hero-lede\">每月多少流量、能同时几台设备、遇到问题找谁。三个问题定下来，套餐就选完了。这一页把这些内容摊开写，省掉来回询问的时间。</p>\n          <blockquote class=\"hero-quote\">\n            “选套餐不是挑最大的，是挑刚好够用、又不浪费的那一档。”\n            银河云 · 选购说明\n          </blockquote>\n        </div>\n        <aside class=\"hero-panel\">\n          <h2>一页速览</h2>\n          <dl>\n            <div class=\"row\"><dt>套餐档位</dt><dd>三档，按月或按年</dd></div>\n            <div class=\"row\"><dt>月度流量</dt><dd>100GB / 300GB / 1000GB</dd></div>\n            <div class=\"row\"><dt>设备数</dt><dd>3 台 / 5 台 / 20 台</dd></div>\n            <div class=\"row\"><dt>年付方式</dt><dd>一次性付清一年</dd></div>\n            <div class=\"row\"><dt>客户端</dt><dd>手机与电脑分别说明</dd></div>\n          </dl>\n          <p class=\"note\">具体可用性以你所在网络环境与设备系统为准。此处不承诺速度、节点数量或兼容范围。</p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"idx\">01 / 使用步骤</span>\n        <h2>三步开始，不需要技术背景</h2>\n        <p>先选套餐，再装客户端，最后填入订阅信息。每一步都留了可核对的细节，出错时按顺序回查。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"card step\">\n          <span class=\"num\">STEP 01</span>\n          <h3>挑一档套餐</h3>\n          <p>按每月实际用量估一档，不要一步到顶。先看设备数，再看流量。</p>\n          <ul>\n            <li>只在手机用：基础版够用</li>\n            <li>手机加电脑：旗舰版的 5 台更从容</li>\n            <li>多人共用：直接看团队版</li>\n          </ul>\n        </article>\n        <article class=\"card step\">\n          <span class=\"num\">STEP 02</span>\n          <h3>装好客户端</h3>\n          <p>手机与电脑选对应的客户端，装好后再做配置。安装前先确认系统版本。</p>\n          <ul>\n            <li>优先用系统自带的应用商店</li>\n            <li>桌面端安装后检查能否正常启动</li>\n            <li>同一账号的设备数不要超限</li>\n          </ul>\n        </article>\n        <article class=\"card step\">\n          <span class=\"num\">STEP 03</span>\n          <h3>填入订阅信息</h3>\n          <p>把账号对应的订阅信息填入客户端，保存后连接测试。连不上先查设备数是否已达上限。</p>\n          <ul>\n            <li>复制粘贴，避免手输错误</li>\n            <li>换设备时先登出旧设备</li>\n            <li>异常时保留界面提示再联系支持</li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"idx\">02 / 套餐</span>\n        <h2>三档套餐，逐行对比</h2>\n        <p>价格、流量、设备数与支持方式写在同一行里，从上往下读一遍就能定。按年付一次性付清，不按月拆分。</p>\n      </div>\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <p class=\"plan-price\">¥15<small> / 月</small></p>\n            <p class=\"plan-year\">按年付 ¥150 / 年</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 100GB 流量</li>\n            <li>3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n        <article class=\"plan featured\">\n          <div class=\"plan-head\">\n            <h3>旗舰版<span class=\"badge\">多数人选这档</span></h3>\n            <p class=\"plan-price\">¥35<small> / 月</small></p>\n            <p class=\"plan-year\">按年付 ¥350 / 年</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 300GB 流量</li>\n            <li>5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <p class=\"plan-price\">¥85<small> / 月</small></p>\n            <p class=\"plan-year\">按年付 ¥850 / 年</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 1000GB 流量</li>\n            <li>20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n      <p class=\"plans-tip\">价格为页面标价，按年付为一次性付清十二个月。套餐权益以对应档位列出的项目为准，不叠加其他档位内容。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"idx\">03 / 客户端</span>\n        <h2>客户端怎么选，按设备分</h2>\n        <p>不同设备走不同路径。安装包请以实际可获取的渠道为准，本页不提供下载地址。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"card client\">\n          <span class=\"tag\">手机</span>\n          <h3>iOS 与 Android</h3>\n          <p>先在手机应用商店里找到对应客户端，安装后打开，把订阅信息粘贴到配置页。首次连接前确认设备数没超上限。</p>\n          <p class=\"meta\">提示：系统升级后如出现启动异常，先重启设备再试。</p>\n        </article>\n        <article class=\"card client\">\n          <span class=\"tag\">桌面</span>\n          <h3>Windows 与 macOS</h3>\n          <p>桌面端适合长时间在线。安装完成后建议先测一次连接，再放到日常使用。多设备轮换时记得先退出旧设备。</p>\n          <p class=\"meta\">提示：安装来源需自行核实，本页不提供安装包。</p>\n        </article>\n        <article class=\"card client\">\n          <span class=\"tag\">路由器</span>\n          <h3>路由器端配置</h3>\n          <p>一台路由器可同时覆盖家中多台设备，适合旗舰版及以上的设备数。配置前先确认路由器型号支持自定义配置。</p>\n          <p class=\"meta\">提示：不同路由器界面差异较大，按设备说明书操作。</p>\n        </article>\n        <article class=\"card client\">\n          <span class=\"tag\">账户</span>\n          <h3>设备管理与切换</h3>\n          <p>同一账号的在线设备数有上限。换新设备前先在旧设备上退出，否则可能提示设备数已满。</p>\n          <p class=\"meta\">提示：设备数上限见各套餐对应条目。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"idx\">04 / 常见问题</span>\n        <h2>问得最多的六件事</h2>\n        <p>问题按顺序编号，答案直接写结论。没提到的情形，以页面上的套餐条目为准。</p>\n      </div>\n      <div class=\"faq-list\">\n        <article class=\"faq\">\n          <h3>三档套餐怎么选？</h3>\n          <p>先看设备数：只有手机用，基础版 3 台足够；手机加电脑，旗舰版 5 台更稳；多人共用或需要路由器覆盖，看团队版 20 台。流量再按日常用量往上加。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>按月付还是按年付？</h3>\n          <p>按年付是一次性付清十二个月，折算下来每月更低。不确定自己会不会长期使用时，先按月付，用满一两个月再换年付。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>提示设备数已满怎么办？</h3>\n          <p>在旧设备上退出登录，再回到新设备重试。设备数按同时在线计算，退出后即可释放名额。仍不行时，记录提示原文再联系支持。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>为什么本页面没有下载链接？</h3>\n          <p>页面只写清安装与配置的步骤，不提供安装包下载。客户端获取渠道请自行核实来源，安装前确认设备与系统版本。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>套餐权益会叠加吗？</h3>\n          <p>不会。每档套餐的权益按对应条目单独计算，旗舰版不会继承基础版条目，团队版也不叠加前两档内容。选哪档就用哪档列出的内容。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>遇到问题找谁？</h3>\n          <p>旗舰版提供 7×24 优先工单支持，团队版有专属客户经理，基础版按常规方式反馈。反馈时附上设备系统、客户端名称与提示原文，能省一轮询问。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"wrap\">\n      <div class=\"notice\">\n        <div>\n          <h2>下单前，请再核对两件事</h2>\n          <p>本页写的价格与权益，以你看到的这份页面内容为准；未列出的能力不做承诺。</p>\n          <ul>\n            <li>月付与年付金额不同，年付一次性付清</li>\n            <li>设备数按同时在线计算</li>\n          </ul>\n        </div>\n        <div>\n          <h2>使用中，记住三条</h2>\n          <p>更换设备先退出旧设备；配置信息用复制粘贴；出现异常先保留提示原文。</p>\n          <ul>\n            <li>不与他人共用同一账号名额</li>\n            <li>安装来源需自行核实</li>\n            <li>页面不含下载与付款链接</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"wrap frow\">\n      <span class=\"fname\">银河云</span>\n      <span>本页为产品说明页面，价格与权益以页面所列条目为准。</span>\n      <span><a href=\"#how\">使用步骤</a> · <a href=\"#plans\">套餐</a> · <a href=\"#clients\">客户端</a> · <a href=\"#faq\">常见问题</a></span>\n    </div>\n  </footer>\n</main>",
